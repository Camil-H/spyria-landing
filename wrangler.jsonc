{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spyria-landing",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "spyria.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
