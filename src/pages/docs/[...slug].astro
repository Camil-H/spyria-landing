---
import { getCollection, render } from 'astro:content'
import { docsRouteOf, isInstallGuide } from '../../docs/routes'
import { summaryOf } from '../../docs/summary'
import Docs from '../../layouts/Docs.astro'

export async function getStaticPaths() {
  const entries = await getCollection('docs', ({ id }) => isInstallGuide(id))
  return entries.map((entry) => ({ params: { slug: docsRouteOf(entry.id).slice('/docs/'.length) }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const title = headings.find(({ depth }) => depth === 1)?.text ?? entry.id
const sections = headings.filter(({ depth }) => depth === 2)
---

<Docs route={docsRouteOf(entry.id)} docsPath={entry.id} title={title} sections={sections} description={summaryOf(entry.body ?? '')}>
  <Content />
</Docs>
