---
import { installOverviewRoute } from '../../docs/routes'
import Docs, { type DocsSection } from '../../layouts/Docs.astro'

const description =
  'Choose where to run Spyria: on a laptop to try it, on a server for your team, or on a cloud. Every option installs the same product.'

const installOptions = [
  {
    slug: 'test-locally',
    title: 'Test locally',
    lines: [
      'On your Mac or Linux laptop, to try Spyria.',
      'Agents run on the same laptop, and Spyria is unreachable while it sleeps.',
    ],
    guides: [{ label: 'One-machine install', href: '/docs/install/one-machine' }],
  },
  {
    slug: 'on-a-server',
    title: 'On a server',
    lines: [
      'On a Linux server or VM, for your team.',
      'Always on, and other machines can be added as runtime hosts for agents.',
    ],
    guides: [
      { label: 'One-machine install', href: '/docs/install/one-machine' },
      { label: 'Manual install', href: '/docs/install/manual-install' },
    ],
  },
  {
    slug: 'on-a-cloud',
    title: 'On a cloud',
    lines: [
      'On AWS, Azure or Google Cloud managed services, for a team that wants a managed database and backups.',
      'One command sets it up with OpenTofu.',
    ],
    guides: [
      { label: 'AWS', href: '/docs/install/aws' },
      { label: 'Azure', href: '/docs/install/azure' },
      { label: 'Google Cloud', href: '/docs/install/google-cloud' },
    ],
  },
]

const oneStepInstall = { slug: 'the-one-step-install', text: 'The one-step install' }

const sections: DocsSection[] = [
  ...installOptions.map((option) => ({ slug: option.slug, text: option.title })),
  oneStepInstall,
]
---

<Docs route={installOverviewRoute} title="Install Spyria" sections={sections} description={description}>
  <h1>Install Spyria</h1>

  <div class="install-options">
    {
      installOptions.map((option) => (
        <section class="install-option">
          <h2 id={option.slug}>{option.title}</h2>
          {option.lines.map((line) => (
            <p>{line}</p>
          ))}
          <p class="install-option-guides">
            {option.guides.map((guide) => (
              <a href={guide.href}>{guide.label}</a>
            ))}
          </p>
        </section>
      ))
    }
  </div>

  <h2 id={oneStepInstall.slug}>{oneStepInstall.text}</h2>
  <pre class="install-command"><code>curl -fsSL https://spyria.dev/install | sh</code></pre>
</Docs>
