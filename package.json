{
  "name": "spyria-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "bun scripts/sync-product.ts",
    "dev": "bun run sync && astro dev",
    "build": "bun run sync && astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "bun run sync && astro check",
    "lint": "biome check .",
    "test:unit": "bun test ./src",
    "test": "playwright test",
    "check:links": "bun scripts/check-links.ts",
    "check:budgets": "bun scripts/check-budgets.ts",
    "check": "bun run typecheck && bun run lint && bun run test:unit && bun run build && bun run check:links && bun run check:budgets && bun run test"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.7",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/outfit": "5.3.0",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.7",
    "beautiful-mermaid": "1.1.3",
    "pagefind": "1.5.2",
    "satteri": "0.11.7",
    "shiki": "4.6.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/bun": "1.4.4",
    "typescript": "6.0.3",
    "wrangler": "4.158.0"
  }
}
